\ProvidesPackage{njust_beamer}[2024/05/19 南京理工大学Beamer模板 v2.0]

% ================================================================================
% 1. 全局变量与参数定义
% ================================================================================
% 字体路径和扩展名全局变量
\newcommand{\fontpath}{./fonts/}
\newcommand{\fontext}{.ttf}

% 设置尺寸相关变量
\newdimen\njust@secbar             % 节导航栏宽度
\setlength{\njust@secbar}{0.7\paperwidth}
\newdimen\njust@sectotitleline     % 小节与标题间分隔线长度
\setlength{\njust@sectotitleline}{\dimexpr\paperwidth-\njust@secbar-15pt\relax}

% ================================================================================
% 2. 宏包导入
% ================================================================================

% --- 2.1 核心功能宏包 ---
\RequirePackage{tikz}              % 提供绘图功能
\usetikzlibrary{calc}              % tikz计算库
\usetikzlibrary{shadows}           % tikz阴影库
\RequirePackage{xcolor}            % 颜色支持

% --- 2.2 数学支持宏包 ---
\RequirePackage{amsmath}           % 数学公式扩展
\RequirePackage{amssymb}           % 数学符号扩展
\RequirePackage{amsfonts}          % 数学字体扩展
\RequirePackage{amsthm}            % 定理环境支持

% --- 2.3 代码和超链接宏包 ---
\RequirePackage{verbatim}          % 原样输出环境
\RequirePackage{hyperref}          % 超链接支持
\RequirePackage{listings}          % 代码语法高亮显示
\RequirePackage{tcolorbox}         % 用于创建彩色和圆角盒子
\tcbuselibrary{breakable, skins}    % 加载tcolorbox的breakable和skins库

% --- 2.4 字体支持宏包 ---
\RequirePackage{fontspec}          % XeLaTeX字体设置

% --- 2.5 表格与图表宏包 ---
\RequirePackage{booktabs}          % 专业表格样式（三线表）
\RequirePackage{multirow}          % 表格中的多行合并
\RequirePackage{tabularray}        % 现代表格环境
\RequirePackage{threeparttable}    % 带注释的表格
\RequirePackage{caption}           % 标题定制
\RequirePackage{etoolbox}          % 环境钩子工具 (用于\AtBeginEnvironment)
\RequirePackage{tabularx}
\RequirePackage{makecell}          % 表格单元格处理

% --- 2.6 脚注与扩展宏包 ---
\RequirePackage{endnotes}          % 尾注支持
\RequirePackage{xpatch}            % 宏补丁工具
\RequirePackage{xunicode-addon}    % Unicode支持扩展

% ================================================================================
% 3. 颜色定义
% ================================================================================

% --- 3.1 基本颜色 ---
% 主色和辅助色定义
\definecolor{njustpurple}      {HTML}{1F5391}  % 南理工紫色（主色）
\definecolor{njustpurple2}     {HTML}{245FA3}  % 南理工紫色（辅色）
\definecolor{njustgray}        {HTML}{4F5F70}  % 南理工灰色
\definecolor{skyblue}          {HTML}{7BA7C7}  % 天蓝色（辅助色）
\definecolor{codepurple}       {RGB}{128,0,128}% 代码中字符串的紫色

% --- 3.2 颜色变体 ---
% 创建主色变体用于不同场景
\colorlet{njustpurple-light}   {njustpurple!70}    % 浅紫色
\colorlet{njustpurple-vlight}  {njustpurple!30}    % 非常浅的紫色
\colorlet{njustpurple-dark}    {njustpurple!120}   % 深紫色

% ================================================================================
% 4. Beamer颜色主题设置
% ================================================================================

% --- 4.1 元素颜色 ---
\setbeamercolor{title}                   {fg=white}
\setbeamercolor{subtitle}                {fg=white}
\setbeamercolor{author}                  {fg=white}
\setbeamercolor{date}                    {fg=white}
\setbeamercolor{institute}               {fg=white}
\setbeamercolor{supervisor}              {fg=white}

% --- 4.2 内容颜色 ---
\setbeamercolor{normal text}             {fg=darkgray, bg=white}
\setbeamercolor{alerted text}            {fg=njustpurple}
\setbeamercolor{structure}               {fg=njustpurple}

% --- 4.3 背景颜色 ---
\setbeamercolor{background canvas}       {bg=white}
\setbeamercolor{jumbo}                   {bg=njustpurple2} % 标题页背景

% --- 4.4 导航栏颜色 ---
\setbeamercolor{section in head/foot}    {fg=white, bg=njustpurple2}
\setbeamercolor{section in head/foot shaded}{fg=white}
\setbeamercolor{subsection in head/foot} {fg=black, bg=njustpurple2}
\setbeamercolor{mini frame}              {fg=white, bg=njustpurple2}
\setbeamercolor{mini frame in current subsection} {fg=njustpurple2, bg=white}

% --- 4.5 页脚颜色 ---
\setbeamercolor{progress bar}            {fg=njustpurple, bg=njustgray}
