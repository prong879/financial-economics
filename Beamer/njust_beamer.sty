\setbeamercolor{subsection in toc shaded}{fg=njustpurple!75, bg=}

% ================================================================================
% 5. 带圈数字脚注定义
% ================================================================================
\makeatletter
% --- 5.1 Unicode字符设置 ---
\xeCJKDeclareCharClass{Default}{"24EA, "2460->"2473, "3251->"32BF}

% --- 5.2 带圈数字字体定义 ---
\newfontfamily\EnclosedNumbers{Garamond-Math.otf}[
  Path = \fontpath,
  Extension = .otf,
  UprightFont=*,
  NFSSFamily=EnclosedNumbers
]

% --- 5.3 带圈数字命令设置 ---
\AtBeginUTFCommand[textcircled]{\begingroup\EnclosedNumbers}
\AtEndUTFCommand[textcircled]{\endgroup}

% --- 5.4 脚注编号格式定义 ---
\renewcommand\thefootnote{\textcircled{\@arabic\c@footnote}}

% --- 5.5 Beamer脚注标签自定义 ---
\setbeamertemplate{footnote label}{%
  \textnormal{\EnclosedNumbers\textcircled{\thevalue{footnote}}}%
  \hspace{0.5em}%
}
\makeatother

