% --- 10.1 帧标题设置 ---
\setbeamertemplate{frametitle}{%
        \ifx\insertframesubtitle\@empty%
    \begin{beamercolorbox}[wd=\paperwidth,%
      ht=2.0ex, dp=0.2ex, leftskip=10pt]{} % Adjusted ht and significantly reduced dp
      \usebeamerfont{frametitle}%
      \usebeamercolor[fg]{frametitle}%
      \insertframetitle%
    \end{beamercolorbox}%
		\else%
    \begin{beamercolorbox}[wd=\paperwidth,%
      ht=2.0ex, dp=0.2ex, leftskip=10pt]{} % Adjusted ht and significantly reduced dp
      \usebeamerfont{frametitle}%
      \usebeamercolor[fg]{frametitle}%
      \insertframetitle~%
      \textcolor{njustpurple2!50}{\rule[-.2ex]{.08em}{1.8ex}}~%
      \usebeamerfont{framesubtitle}%
      \usebeamercolor[fg]{framesubtitle}%
      \insertframesubtitle%
    \end{beamercolorbox}%
  \fi%
}

% --- 10.2 底部进度条和信息栏 ---
\defbeamertemplate{footline}{progress bar}{
	\dimen0=\paperwidth
    \divide\dimen0 by \inserttotalframenumber
	\multiply\dimen0 by \insertframenumber
	\edef\progressbarwidth{\the\dimen0}
	\leavevmode%
	\ifnum\theframenumber=1
	\else
        % 融合信息栏和进度条
        \begin{beamercolorbox}[wd=\paperwidth,ht=10pt,dp=3pt]{page number in head/foot}
            % 首先绘制进度条作为背景
            \begin{pgfpicture}{0pt}{0pt}{\paperwidth}{13pt}
                % 未完成部分 - 使用njustpurple2作为背景
                \pgfpathrectangle{\pgfpointorigin}{\pgfpoint{\paperwidth}{13pt}}
                \pgfsetfillcolor{njustpurple2!80}
