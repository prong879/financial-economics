% --- 9.1 页眉背景底图 ---
\newsavebox{\njust@headlinebox}
\begin{lrbox}{\njust@headlinebox}
  \begin{tikzpicture}
    % 绘图辅助节点定义
    \coordinate (LineNorthWest) at (0, -11pt);  % 小节-标题分隔线西北节点
    \coordinate (LineSouthWest) at (0, -13pt);  % 小节-标题分隔线西南节点
    \coordinate (LineSouthEast) at (\njust@sectotitleline, -13pt);  % 小节-标题分隔线东南节点
    \coordinate (SecbarNorthEast) at (\paperwidth, 0);  % 章节栏东北节点
    \coordinate (SecbarSouthEast) at (\paperwidth, -13pt);  % 章节栏东南节点
    \coordinate (SecbarSouthWest) at ([xshift=-\njust@secbar]SecbarSouthEast);  % 章节栏西南节点
    \coordinate (SecbarNorthWest) at ([xshift=-6.5pt, yshift=13pt]SecbarSouthWest);  % 章节栏西北节点
    \coordinate (AdornDarkNorthWest) at ([xshift=-4pt]SecbarNorthWest);  % 深色装饰西北节点
    \coordinate (AdornDarkSouthEast) at ([xshift=3.5pt, yshift=-7pt]SecbarNorthWest);  % 深色装饰东南节点
    \coordinate (AdornLightNorthWest) at ([xshift=-4pt]AdornDarkSouthEast);  % 浅色装饰西北节点
    \coordinate (AdornLightSouthEast) at ([xshift=2pt, yshift=-4pt]AdornDarkSouthEast);  % 浅色装饰东南节点

    % 颜色图形绘制
    \fill[njustpurple2] (SecbarNorthEast) -- (SecbarSouthEast)  % 章节栏背景
      -- (SecbarSouthWest) -- (SecbarNorthWest) -- cycle;
    \fill[njustpurple] (AdornDarkNorthWest) -- (SecbarNorthWest)  % 深色装饰
      -- (AdornDarkSouthEast) -- ++ (-4pt, 0) -- cycle;
    \fill[njustpurple!70] (AdornLightNorthWest) -- (AdornDarkSouthEast)  % 浅色装饰
      -- (AdornLightSouthEast) -- ++ (-4pt, 0) -- cycle;
    \fill[njustpurple2] (LineNorthWest) -- (LineSouthWest)  % 小节与标题间分隔线
      -- (LineSouthEast) -- ++ (-1pt, 2pt) -- cycle;
  \end{tikzpicture}
\end{lrbox}

% --- 9.2 导航栏辅助函数 ---
% 插入章节栏水平导航
\def\njust@insert@secbar{%
  \insertsectionnavigationhorizontal{\njust@secbar}{%
    % 非当前章节样式 (黑体)
    \begingroup\usebeamerfont{section in head/foot}\usebeamercolor[fg]{section in head/foot}\endgroup%
  }{%
    % 当前章节样式 (黑体)
    \begingroup\usebeamerfont{section in head/foot shaded}\usebeamercolor[fg]{section in head/foot shaded}\endgroup%
  }%
}

% 插入小节标题
\def\njust@insert@subsec{%
  \begingroup%
  \usebeamerfont{subsection in head/foot}%
  \usebeamercolor[fg]{subsection in head/foot}%
  \heiti %
  \insertsubsectionhead%
  \endgroup%
}

% 插入小节迷你帧
\def\njust@insert@subsecminiframes#1#2{%
  % #1:: baselineskip - 行间距
  % #2:: mini-frames space - 小圆点间距
  \setlength{\baselineskip}{#1}%
  \usebeamercolor[fg]{subsection in head/foot}%
  \def\sectionentry##1##2##3##4##5{}%
  \def\slideentry##1##2##3##4##5##6{%
    % section number, subsection number, slide number, first/last frame,
    % last subsection, part number
    \ifnum##6=\c@part\ifnum##1=\c@section\ifnum##2>0\ifnum##3>0%
      \beamer@link(##4){%
        \usebeamerfont{mini frames}%
        \ifnum\c@subsection=##2%
          \usebeamercolor{mini frame}%
          \ifnum\c@subsectionslide<##3%
            \usebeamertemplate{mini frame in current subsection}%
            \hskip#2%
          \else%
            \usebeamertemplate{mini frame}%
            \hskip#2%
          \fi%
        \fi%
      }%
      % 这里添加一个负宽度空格，防止换行断开超链接
        \hskip0pt%
    \fi\fi\fi\else%
      \fakeslideentry{##1}{##2}{##3}{##4}{##5}{##6}%
    \fi%
    \ignorespaces%
  }%
  \setbox\beamer@sectionbox=\hbox{}%
  \hskip0pt\dohead%
  \box\beamer@sectionbox%
}

% --- 9.3 页眉样式定义 ---
\def\njust@headline{%
  \ifnum\theframenumber=1
    % 标题页不显示页眉
  \else
    \begin{tikzpicture}[overlay, remember picture]%
      \heiti % 强制整个页眉使用思源黑体
      % 绘图辅助节点定义
      \coordinate (NorthEast) at (current page.north east);  % 东北节点
      \coordinate (NorthWest) at (current page.north west);  % 西北节点

      % 图形文字绘制
      \node[anchor=north west, inner sep=0pt, outer sep=0pt] at (NorthWest) {%
        \usebox{\njust@headlinebox}};  % 绘制headline背景底图
      \node[left, inner sep=0pt, outer sep=0pt,
        yshift=-7pt] at (NorthEast) {\njust@insert@secbar};  % 绘制章节栏水平导航

      % 绘制小节标题 - 先绘制，并记录位置
      \node[right, inner sep=0pt, outer sep=0pt,
        xshift=9pt, yshift=-5.75pt] at (NorthWest) (Subsec) {\njust@insert@subsec};

      % 测量小节标题的宽度，然后在其右侧绘制迷你帧，确保不重叠
      \path let \p1 = (Subsec.east) in
        node[anchor=west, inner sep=0pt, outer sep=0pt,
          xshift=6pt, yshift=-0.5pt] at (\p1) (MiniFrames) {%
          \parbox{\dimexpr\njust@sectotitleline-\x1+4pt\relax}{%
            \raggedright\njust@insert@subsecminiframes{3.8pt}{1.6pt}%
          }%
        };
    \end{tikzpicture}%
  \fi
}

% --- 9.4 页眉模板设置 ---
\setbeamertemplate{headline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=15pt,dp=1pt]{}% Reduced ht from 20pt to 15pt
    \njust@headline%
  \end{beamercolorbox}%
}

% --- 9.5 迷你帧样式设置 ---
\setbeamertemplate{mini frame}{\tikz\draw[fill=njustpurple2, draw=white] circle (0.4ex);}
\setbeamertemplate{mini frame in current subsection}{\tikz\draw[fill=white, draw=njustpurple2] circle (0.4ex);}
\makeatother

