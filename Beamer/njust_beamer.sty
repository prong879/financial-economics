% ================================================================================
% 13. 自定义卡片环境 (NJUST TikZ Card)
% ================================================================================
% 需要 tikz 宏包 (已在前面加载)

\newsavebox{\njusttikzcardbody}
\newcommand{\njusttikzcardcurrenttitle}{}

\newenvironment{njusttikzcard}[1]%
  {% 环境开始部分
    \renewcommand{\njusttikzcardcurrenttitle}{#1}% Store the title
    \begin{lrbox}{\njusttikzcardbody}%
    \begin{minipage}{\dimexpr\linewidth-5mm-1pt\relax} % Adjusted for new inner sep (2.5mm*2)
      \normalsize\heiti % 设置盒子内容的基础字体
  }%
  {% 环境结束部分
    \end{minipage}%
    \end{lrbox}%
    % 绘制卡片
    \begin{tikzpicture}%
      \node[
        draw=black, % 黑色边框
        line width=0.5pt, % 边框宽度
        fill=white, % 白色背景
        rounded corners=2mm, % 圆角半径
        text width=\dimexpr\linewidth-5mm-1pt\relax, % Adjusted for new inner sep
        inner sep=2.5mm, % Reduced inner padding for compactness
        align=left, % 节点内文本左对齐
      ] (cardbox) {%
        {\large\bfseries\heiti \njusttikzcardcurrenttitle} % Title: smaller, bold, normal size
        % Corrected check for body content:
        \ifdim\njusttikzcardbodytext > 0pt
          \vspace{2mm} % Reduced space between title and body for compactness
          \par
          \usebox{\njusttikzcardbody} % 内容部分
        \fi
      };%
    \end{tikzpicture}%
  }
% 辅助命令，检查 savebox 是否为空（近似）
% tcolorbox 使用更复杂的方法，这里简化处理，主要用于有内容时才加vspace
\newcommand{\njusttikzcardbodytext}{\dimexpr\wd\njusttikzcardbody+\ht\njusttikzcardbody+\dp\njusttikzcardbody\relax}
