                % 已完成部分 - 使用njustpurple作为进度
                \pgfpathrectangle{\pgfpointorigin}{\pgfpoint{\progressbarwidth}{13pt}}
                \pgfsetfillcolor{njustpurple}
                \pgfusepath{fill}
            \end{pgfpicture}%

            % 然后在进度条上显示信息文本
            \vskip-13pt% 回到起始位置
            \usebeamerfont{footline}%
            \color{white}% 白色文本以确保在紫色背景上清晰可见
            \vbox to 10pt{\vfil
              \hbox{%
                \hspace{3ex}
                \makebox[0.10\paperwidth][l]{\insertshortauthor}% 作者信息宽度调整
